<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_strong"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/emergency_title"
        android:textColor="@color/clock_yellow"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/callEmergency"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_button_red"
        android:minHeight="72dp"
        android:textSize="24sp" />

    <Button
        android:id="@+id/callContact"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_blue"
        android:minHeight="72dp"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/noContactHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/no_contact_hint"
        android:textColor="@color/text_dim"
        android:textSize="16sp" />

    <Button
        android:id="@+id/cancelEmergency"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_grey"
        android:text="@string/cancel_emergency" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/emergency_note"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />
</LinearLayout>
