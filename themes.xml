<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SimpleLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <!-- Big, high-contrast button. Set android:background to one of the bg_button_* drawables. -->
    <style name="BigButton" parent="android:Widget.DeviceDefault.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SettingsHeading">
        <item name="android:textColor">@color/clock_yellow</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="SettingsInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">20sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
